{
  "name": "anki-global-kit",
  "displayName": "Anki Global Kit",
  "version": "1.1.1",
  "description": "A global kit for Anki with features that work across all Anki apps.",
  "publisher": "jacobcassidy",
  "author": {
    "name": "Jacob Cassidy",
    "email": "hello@jacobcassidy.com",
    "url": "https://jacobcassidy.com"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/jacobcassidy/anki-global-kit-addon"
  },
  "bugs": {
    "url": "https://github.com/jacobcassidy/anki-global-kit-addon/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "@cassidydc/stylelint-config-w3c-order": "^1.3.1",
    "@eslint/js": "^10.0.1",
    "@stylistic/stylelint-config": "^5.0.0",
    "diff-match-patch": "1.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "lefthook": "^2.1.17",
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.9.9",
    "prettier-plugin-multiline-arrays": "^4.1.11",
    "pyright": "1.1.414",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-block-no-ignored-properties": "^3.0.0",
    "stylelint-high-performance-animation": "^2.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-plugin-logical-css": "^2.1.0"
  },
  "overrides": {
    "katex": "0.18.2",
    "smol-toml": "1.9.0",
    "source-map-js": "1.2.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "lefthook@2.1.17": true,
    "unrs-resolver@1.12.2": true
  },
  "scripts": {
    "build": "node scripts/build-assets.js",
    "check": "npm run check:prettier && npm run check:py && npm run typecheck:py",
    "check:prettier": "npx prettier . --check",
    "check:py": "uv run --locked ruff format --check .",
    "dev:link-addon": "node scripts/link_addon.js",
    "format:prettier": "npx prettier . --write",
    "format:py": "uv run --locked ruff format .",
    "install:lefthook": "npx lefthook install",
    "install:py-deps": "uv sync --locked",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:md && npm run lint:py",
    "lint:css": "npx stylelint \"**/*.css\" --ignore-path .gitignore --allow-empty-input",
    "lint:css:fix": "npx stylelint \"**/*.css\" --ignore-path .gitignore --allow-empty-input --fix",
    "lint:js": "npx eslint",
    "lint:js:fix": "npx eslint --fix",
    "lint:md": "npx markdownlint-cli2 \"**/*.md\"",
    "lint:md:fix": "npx markdownlint-cli2 \"**/*.md\" --fix",
    "lint:py": "uv run --locked ruff check .",
    "lint:py:fix": "uv run --locked ruff check --fix .",
    "package:addon": "python3 scripts/package_addon.py",
    "test": "npm run test:js && npm run test:py",
    "test:js": "node --import ./tests/support/register-svg.js --test \"tests/javascript/**/*.test.js\"",
    "test:py": "python3 -m unittest discover -s tests/python -t . -p \"test_*.py\"",
    "typecheck:py": "pyright",
    "verify:package-assets": "python3 scripts/verify_package_assets.py",
    "watch": "node scripts/watch-assets.js"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@lezer/javascript": "1.5.6",
    "@lezer/python": "1.1.18",
    "highlight.js": "11.11.1"
  }
}
